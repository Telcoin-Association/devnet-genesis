# bench7-adaptive.env — bench 7, every switch of the build on, the vote fix adaptive: a header names the
# node's own tip, and the quorum's block only in the next 4 headers it builds after one of its own was
# cancelled uncertified.
# The shape of bench 6's run r20261113-1351 (tasks/bench6/r20261113-1351/bench6-run2.env): deploy to step 12
# with the arm applied at step 7, the idle window, steps 13-15 (two light blasts, then the chaos profile with
# the kill of bench-validator-05), teardown without the archive gate, then reindex, archive and bundle.
# bench7-always.env and bench7-adaptive.env differ only in BENCH_ARM_FILE and this header (README.md, "Bench 7").
# Parsed by launch.sh, never sourced: KEY=value lines only (README.md, "Env files").
# Fill the <...> placeholders at the image cut (tasks/bench7/orch-image-cut.sh prints the digest; the commit is
# the one it built) and commit the file, or fill a copy outside benchmark/ and launch with that copy.
# Every BENCH_* variable of the launching shell is dropped first: this file is the whole configuration.

BENCH_RUN_ID=r20261115-1653

# The node image by digest, the commit it must report and its forks (bench-lib.sh step-0 image gate). The
# gate also records the storage engine the binary names (manifest storage_engine: tn-lmdb on this build).
BENCH_DOCKER_IMAGE=us-docker.pkg.dev/telcoin-network/tn-public/adiri@sha256:15acdccafff786c2aa60ac69cddc3b09069648d5cf22ae1727c060fafa68822c
BENCH_DOCKER_IMAGE_EXPECT_DIGEST=sha256:15acdccafff786c2aa60ac69cddc3b09069648d5cf22ae1727c060fafa68822c
BENCH_NODE_EXPECT_SHA=91a15e22376fa1277c107824e738dce689792c56
BENCH_NODE_EXPECT_FORKS=subsecond-from-genesis
# The faucet build of upstream main starts only with the allowance (#1716), and the node's listener ports
# leave the kernel's ephemeral range before its first start (both deploy step 7; 1 is also config.sh's default).
BENCH_NODE_ALLOW_FAUCET_ON_CHAIN=1
BENCH_NODE_RESERVE_PORTS=1
# The generator image (deploy step 1 builds blast-v2-<sha>): bench 6's, unchanged.
BENCH_TXGEN_SHA=62bbd5f
# The boot image bench 5 and bench 6 ran, pinned (never a family).
BENCH_NODE_BOOT_IMAGE=projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261105

# The fleet run r20261113-1351 had, written out (config.sh's defaults): c3-highcpu-8 on a 100 GB
# hyperdisk-balanced data disk provisioned at 20,000 IOPS and 800 MiB/s. The zones are config.sh's list.
BENCH_MACHINE_TYPE=c3-highcpu-8
BENCH_NODE_DISK_TYPE=hyperdisk-balanced
BENCH_NODE_DISK_SIZE=100
BENCH_NODE_DISK_IOPS=20000
BENCH_NODE_DISK_THROUGHPUT=800

# The configuration, applied by deploy step 7 before the first start (no restart).
BENCH_ARM_FILE=benchmark/arms/bench7-adaptive.arm

# Measurements: the persist sampler, the generator's tail scan, the bench-5 light start lead,
# sampled landings.
BENCH_PERSIST_SAMPLER=1
BENCH_TAIL_SCAN_SECS=180
BENCH_LIGHT_START_DELAY_SECS=150
BENCH_LANDINGS_SAMPLE=100

# Bench 5's chaos profile over a 2,400-s mixed phase, after the light blasts 8 x 16 and 600 x 4.
BENCH_CHAOS=1
BENCH_DURATION_SECS=2400
BENCH_LIGHT_LOAD=1
BENCH_LIGHT_SENDERS="8 600"
BENCH_LIGHT_WINDOWS="16 4"

# The teardown deletes without uploading first; the archive segment uploads afterwards.
BENCH_TEARDOWN_SKIP_ARCHIVE=1
