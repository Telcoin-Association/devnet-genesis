# binary (the repo root only: fixture dirs that mirror a node's /etc/telcoin stay tracked)
/telcoin

# validator configs
telcoin-network.yaml

# keys
*.key

# BLS keystore passphrase + other operator secrets (devnet-lib.sh reads .secrets/bls-passphrase)
.secrets/

# env
.env
.env.makefile

# run logs of the root drivers (devnet-*.sh write <repo>/logs/<stamp>-<step>/), and a root archive/;
# anchored, so a fixture or tasks/archive/ file of that name is not swallowed
/logs/
/archive/
**/.DS_Store

# local build output (publish bundles); never committed
/dist/

# subagent checkpoint files (scratch state, never committed)
tasks/checkpoint-*.md

# python bytecode (benchmark/report, benchmark/tests)
__pycache__/
