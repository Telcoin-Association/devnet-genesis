# bench7-adaptive: bench7-always with the vote fix in its adaptive form.
# quorum_exec_block_starved_rounds 4: a header names the node's own tip by default; the next 4
# headers the node builds after one of its own was cancelled uncertified use the quorum rule (the
# window counts headers built, not rounds, and doubles while cancels repeat, up to 128).
# No host step, as in bench7-always.
name bench7-adaptive
param quorum_exec_block true
param quorum_exec_block_starved_rounds 4
param vote_queue_fix true
param digest_order_hold true
param epoch_record_collect_past_uncertified true
param epoch_record_conflict_halt true
param epoch_record_recertify true
