# GR100 (optional, only if GR150 misses its target): a 100 ms parent grace instead of 150 ms.
# Must show the same as GR150.
build bench6
name gr100
param mdbx_random_advice true
param quorum_exec_block true
param quorum_exec_block_starved_rounds 4
param vote_queue_fix true
param epoch_record_state_check true
param sealed_tx_keep true
param digest_dedupe true
param recovery_threads 3
param epoch_close_task_drain true
param pipelined_persist true
param rpc_admission_backlog_outputs 3
param parent_grace 100ms
host evict-mdbx
