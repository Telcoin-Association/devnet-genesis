# bench8-control: bench 7's always-on arm (bench7-always) with the new count written out; runs C and R.
# quorum_exec_block_floor_outputs 8 is the bench 8 build's default and quorum_exec_block_starved_rounds 0
# bench 7's, both written out so the variant is plain: the other bench 8 arms change one line of this file.
# No host step: the bench 8 build stores its execution state in tn-lmdb, and a node that never
# started has nothing to evict.
name bench8-control
param quorum_exec_block true
param quorum_exec_block_starved_rounds 0
param quorum_exec_block_floor_outputs 8
param vote_queue_fix true
param digest_order_hold true
param epoch_record_collect_past_uncertified true
param epoch_record_conflict_halt true
param epoch_record_recertify true
