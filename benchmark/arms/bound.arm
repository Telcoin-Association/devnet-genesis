# BOUND: RPC admission bounded at 3 outputs of execution backlog, on top of PIPE (3 with the pipelined
# persist, which holds one more output in flight; the design's value without it is 2).
# Abort the arm when a validator enters with rounds-behind >= 30.
# Must show: seen p50 and p95 at M16 against M4; time blocked at the window; tx/s not lower.
build bench6
name bound
param mdbx_random_advice true
param quorum_exec_block true
param quorum_exec_block_starved_rounds 4
param vote_queue_fix true
param epoch_record_state_check true
param sealed_tx_keep true
param digest_dedupe true
param recovery_threads 3
param epoch_close_task_drain true
param pipelined_persist true
param rpc_admission_backlog_outputs 3
host evict-mdbx
