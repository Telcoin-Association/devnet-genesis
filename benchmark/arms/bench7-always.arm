# bench7-always: every switch of the bench 7 build on, the vote fix in its always-on form.
# quorum_exec_block_starved_rounds 0 is the default, written out so the variant is plain: every
# header names the execution block a quorum holds.
# No host step: the bench 7 build stores its execution state in tn-lmdb, and a node that never
# started has nothing to evict.
build bench7
name bench7-always
param quorum_exec_block true
param quorum_exec_block_starved_rounds 0
param vote_queue_fix true
param digest_order_hold true
param epoch_record_collect_past_uncertified true
param epoch_record_conflict_halt true
param epoch_record_recertify true
