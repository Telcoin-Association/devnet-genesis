# bench6-run1-lssd.env — run 1b, the local-SSD deployment of run 1 (option e): deploy to step 12, the
# walk of bench6-run1-lssd.plan (launch with `arms --plan benchmark/launch/bench6-run1-lssd.plan`), step 15,
# teardown without the archive gate, then archive and reindex. It runs after run 1's teardown (the instance
# names are fixed), under its own run id, with run 1's image, generator and boot image.
# Parsed by launch.sh, never sourced: KEY=value lines only (README.md, "Env files").
# Fill the <...> placeholders with run 1's values (a fresh run id) and commit the file (launch.sh refuses a
# placeholder and a dirty harness tree), or fill a copy outside benchmark/ and launch with that copy.
# Every BENCH_* variable of the launching shell is dropped first: this file is the whole configuration.

BENCH_RUN_ID=<run-id>

# The node image by digest, the commit it must report and its forks (bench-lib.sh step-0 image gate).
BENCH_DOCKER_IMAGE=us-docker.pkg.dev/telcoin-network/tn-public/adiri@sha256:<image-digest>
BENCH_DOCKER_IMAGE_EXPECT_DIGEST=sha256:<image-digest>
BENCH_NODE_EXPECT_SHA=<node-sha>
BENCH_NODE_EXPECT_FORKS=subsecond-from-genesis
# The generator image (deploy step 1 builds blast-v2-<sha>).
BENCH_TXGEN_SHA=<txgen-sha>
# The boot image bench 5 ran, pinned (never a family).
BENCH_NODE_BOOT_IMAGE=projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261105

# The shape: three machine types, every node in run 1's zone, every node with the fleet's 100 GB
# hyperdisk-balanced boot disk.
#   validators 03, 04, 05, 06, 07, 10 (indices 2-6, 9): c3-standard-8-lssd (32 GiB), the data directory on
#     the first local NVMe SSD, mounted at deploy step 3;
#   validators 01, 02 and the observer (indices 0, 1, 10): c3-standard-8 (32 GiB), data directory on the boot disk;
#   validators 08, 09 (indices 7, 8): c3-highcpu-8 (16 GiB, run 1's shape: BENCH_MACHINE_TYPE stays unset, so
#     the default MACHINE_TYPE), data directory on the boot disk. c3-standard-8 does not exist in their zones.
BENCH_NODE_MACHINE_TYPES="0:c3-standard-8 1:c3-standard-8 2:c3-standard-8-lssd 3:c3-standard-8-lssd 4:c3-standard-8-lssd 5:c3-standard-8-lssd 6:c3-standard-8-lssd 9:c3-standard-8-lssd 10:c3-standard-8"
BENCH_NODE_DATADIR_LSSD=1
# Six validators on a local SSD, four on the Hyperdisk boot disk (config.sh needs it named with the knob above).
BENCH_FLEET=c3-lssd6-hdb4
# Stockout fallbacks, each zone read on 2026-11-12 to offer the node's own type. Indices 0, 1 and 10 have
# none. Tokyo (index 3, asia-northeast1-b) has none either: no other Tokyo zone offers c3-standard-8-lssd,
# so a stockout there stops the deploy at step 2.
BENCH_ZONE_FALLBACKS="2:australia-southeast1-a,australia-southeast1-b 4:us-east4-c,us-east4-a 5:europe-west4-b,europe-west4-c 6:asia-southeast1-a,asia-southeast1-c 7:asia-east1-a 8:asia-northeast3-b 9:asia-south1-b,asia-south1-a"

# Measurements: the persist sampler, the generator's tail scan (run-arms gives it to M16 only),
# the bench-5 light start lead, sampled landings.
BENCH_PERSIST_SAMPLER=1
BENCH_TAIL_SCAN_SECS=180
BENCH_LIGHT_START_DELAY_SECS=150
BENCH_LANDINGS_SAMPLE=100

# No chaos (run-arms also sets it on every blast); the fleet starts in the control state
# (no BENCH_ARM_FILE: arm A0 is the fleet as deployed, never restarted).
BENCH_CHAOS=0
BENCH_LIGHT_LOAD=0

# The teardown deletes without uploading first; the archive segment uploads afterwards.
BENCH_TEARDOWN_SKIP_ARCHIVE=1

# run-arms.sh: every node's queued pool below this before M4, M16 and M16s (0 = no gate).
RUN_ARMS_MAX_QUEUED=1000
