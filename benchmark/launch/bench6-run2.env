# bench6-run2.env — run 2, the headline (plan W6): deploy to step 12 with the final arm applied at
# step 7, the idle window, steps 13-15 (two light blasts, then the chaos profile), teardown without the
# archive gate, then reindex, archive and bundle.
# Parsed by launch.sh, never sourced: KEY=value lines only (README.md, "Env files").
# Fill the <...> placeholders at gate G5 and commit the file (launch.sh refuses a placeholder and a dirty
# harness tree), or fill a copy outside benchmark/ and launch with that copy. benchmark/arms/final.arm
# must hold the configuration chosen at G3 before the deploy.
# Every BENCH_* variable of the launching shell is dropped first: this file is the whole configuration.

BENCH_RUN_ID=<run-id>

# The node image by digest, the commit it must report and its forks (bench-lib.sh step-0 image gate).
BENCH_DOCKER_IMAGE=us-docker.pkg.dev/telcoin-network/tn-public/adiri@sha256:<image-digest>
BENCH_DOCKER_IMAGE_EXPECT_DIGEST=sha256:<image-digest>
BENCH_NODE_EXPECT_SHA=<node-sha>
BENCH_NODE_EXPECT_FORKS=subsecond-from-genesis
# The generator image (deploy step 1 builds blast-v2-<sha>).
BENCH_TXGEN_SHA=<txgen-sha>
# The boot image bench 5 ran, pinned (never a family).
BENCH_NODE_BOOT_IMAGE=projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261105

# The final configuration, applied by deploy step 7 before the first start (no restart).
BENCH_ARM_FILE=benchmark/arms/final.arm

# Measurements: the persist sampler, the generator's tail scan, the bench-5 light start lead,
# sampled landings.
BENCH_PERSIST_SAMPLER=1
BENCH_TAIL_SCAN_SECS=180
BENCH_LIGHT_START_DELAY_SECS=150
BENCH_LANDINGS_SAMPLE=100

# The headline: bench 5's chaos profile over a 2,400-s mixed phase, after the light blasts 8 x 16 and
# 600 x 4 (bench 5's 16 x 16 is dropped).
BENCH_CHAOS=1
BENCH_DURATION_SECS=2400
BENCH_LIGHT_LOAD=1
BENCH_LIGHT_SENDERS="8 600"
BENCH_LIGHT_WINDOWS="16 4"

# The teardown deletes without uploading first; the archive segment uploads afterwards.
BENCH_TEARDOWN_SKIP_ARCHIVE=1
